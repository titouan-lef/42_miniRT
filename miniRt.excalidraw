      "isDeleted": false,
      "boundElements": [],
      "updated": 1748019869735,
      "link": null,
      "locked": false,
      "text": "(x - x₀)² + (y - y₀)² + (z - z₀)² = r",
      "fontSize": 16.378772981044403,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "(x - x₀)² + (y - y₀)² + (z - z₀)² = r",

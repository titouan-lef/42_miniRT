    {
      "id": "VVZ9DfKeGwzX01f4hiof-",
      "type": "text",
      "x": 3241.83361772022,
      "y": 2000.810205999459,
      "width": 204.02777777777786,
      "height": 330.1691216584834,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

    {
      "id": "5RtS6bTZNtKQ0p9zCRo5f",
      "type": "text",
      "x": 1034.956633593227,
      "y": 2700.703063142315,
      "width": 420.27777777777777,
      "height": 61.906710310965636,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],

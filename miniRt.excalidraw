    {
      "id": "wlbwlVpuMY2vwDoFZNUfU",
      "type": "text",
      "x": 4753.174943389273,
      "y": 940.9347275057664,
      "width": 1109.85888671875,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHC",
      "roundness": null,
      "seed": 1351324940,
      "version": 127,
      "versionNonce": 1433504948,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1746451474842,
      "link": null,
      "locked": false,
      "text": "Soit q₁(s₁, x₁ * i, y₁ * j, z₁ * k) et q₂(s₂, x₂ * i, y₂ * j, z₂ * k)\nSoit v₁(x₁ * i, y₁ * j, z₁ * k) et v₂(x₂ * i, y₂ * j, z₂ * k)\n\nq₁ * q₂ = (s₁ + x₁ * i + y₁ * j + z₁ * k) * (s₂ + x₂ * i + y₂ * j + z₂ * k)\nq₁ * q₂ = (s₁ + v₁) * (s₂ + v₂)\nq₁ * q₂ = s₁ * s₂ + s₁ * v₂ + v₁ * s₂ + v₁ * v₂\n\nv₁ * v₂ = (x₁ * i + y₁ * j + z₁ * k) * (x₂ * i + y₂ * j + z₂ * k)\n\nSachant que i² = j² = k² = -1\n\nv₁ * v₂ = -x₁x₂ + x₁y₂ ij + x₁z₂ ik - y₁y₂ + y₁x₂ ji + y₁z₂ jk - z₁z₂ + z₁x₂ ki + z₁y₂ kj\nv₁ * v₂ = - (x₁x₂ + y₁y₂ + z₁z₂) + x₁y₂ ij + x₁z₂ ik + y₁x₂ ji + y₁z₂ jk + z₁x₂ ki + z₁y₂ kj\nv₁ * v₂ = - (v₁ . v₂) + x₁y₂ ij + x₁z₂ ik + y₁x₂ ji + y₁z₂ jk + z₁x₂ ki + z₁y₂ kj\n\nSachant que i, j et k sont les 3 axes (normalizés) du repere, leur multiplication correspond à leur produit vectoriel.\nAinsi,\ni * j = k\ni * k = -j\nj * i = -k\nj * k = i\nk * i = j\nk * j = -i\n\nv₁ * v₂ = - (v₁ . v₂) + x₁y₂ k - x₁z₂ j - y₁x₂ k + y₁z₂ i + z₁x₂ j - z₁y₂ i\nv₁ * v₂ = - (v₁ . v₂) + (y₁z₂ - z₁y₂) i + (z₁x₂ - x₁z₂) j + (x₁y₂ - y₁x₂) k\nv₁ * v₂ = - (v₁ . v₂) + v₁ ^ v₂\n\nq₁ * q₂ = s₁ * s₂ + s₁ * v₂ + v₁ * s₂ - (v₁ . v₂) + v₁ ^ v₂\nq₁ * q₂ = s₁ * s₂ - (v₁ . v₂) + s₁ * v₂ + v₁ * s₂ + v₁ ^ v₂",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Soit q₁(s₁, x₁ * i, y₁ * j, z₁ * k) et q₂(s₂, x₂ * i, y₂ * j, z₂ * k)\nSoit v₁(x₁ * i, y₁ * j, z₁ * k) et v₂(x₂ * i, y₂ * j, z₂ * k)\n\nq₁ * q₂ = (s₁ + x₁ * i + y₁ * j + z₁ * k) * (s₂ + x₂ * i + y₂ * j + z₂ * k)\nq₁ * q₂ = (s₁ + v₁) * (s₂ + v₂)\nq₁ * q₂ = s₁ * s₂ + s₁ * v₂ + v₁ * s₂ + v₁ * v₂\n\nv₁ * v₂ = (x₁ * i + y₁ * j + z₁ * k) * (x₂ * i + y₂ * j + z₂ * k)\n\nSachant que i² = j² = k² = -1\n\nv₁ * v₂ = -x₁x₂ + x₁y₂ ij + x₁z₂ ik - y₁y₂ + y₁x₂ ji + y₁z₂ jk - z₁z₂ + z₁x₂ ki + z₁y₂ kj\nv₁ * v₂ = - (x₁x₂ + y₁y₂ + z₁z₂) + x₁y₂ ij + x₁z₂ ik + y₁x₂ ji + y₁z₂ jk + z₁x₂ ki + z₁y₂ kj\nv₁ * v₂ = - (v₁ . v₂) + x₁y₂ ij + x₁z₂ ik + y₁x₂ ji + y₁z₂ jk + z₁x₂ ki + z₁y₂ kj\n\nSachant que i, j et k sont les 3 axes (normalizés) du repere, leur multiplication correspond à leur produit vectoriel.\nAinsi,\ni * j = k\ni * k = -j\nj * i = -k\nj * k = i\nk * i = j\nk * j = -i\n\nv₁ * v₂ = - (v₁ . v₂) + x₁y₂ k - x₁z₂ j - y₁x₂ k + y₁z₂ i + z₁x₂ j - z₁y₂ i\nv₁ * v₂ = - (v₁ . v₂) + (y₁z₂ - z₁y₂) i + (z₁x₂ - x₁z₂) j + (x₁y₂ - y₁x₂) k\nv₁ * v₂ = - (v₁ . v₂) + v₁ ^ v₂\n\nq₁ * q₂ = s₁ * s₂ + s₁ * v₂ + v₁ * s₂ - (v₁ . v₂) + v₁ ^ v₂\nq₁ * q₂ = s₁ * s₂ - (v₁ . v₂) + s₁ * v₂ + v₁ * s₂ + v₁ ^ v₂",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JSYsMRAiWW9-JW7YFgLVq",

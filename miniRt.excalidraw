      "index": "bFh",
      "roundness": null,
      "seed": 1980342208,
      "version": 1873,
      "versionNonce": 688707824,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1748002497318,
      "link": null,
      "locked": false,
      "text": "x = x₀ + r * sin(θ) * cos(φ)\ny = y₀ + r * sin(θ) * sin(φ)\nz = z₀ + r * cos(θ)",
      "fontSize": 16.50845608292417,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "x = x₀ + r * sin(θ) * cos(φ)\ny = y₀ + r * sin(θ) * sin(φ)\nz = z₀ + r * cos(θ)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "XGQT0OELgo-woOOTolgJc",
      "type": "text",
      "x": 1022.4301008599764,
      "y": 3130.3827694249217,
      "width": 291.0451289585658,
      "height": 21.439433978313588,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,

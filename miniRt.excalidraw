    },
    {
      "id": "N9w4ZI-S4LYDor27-829X",
      "type": "text",
      "x": 2600.909014545609,
      "y": 1454.1316345708867,
      "width": 420.27777777777777,
      "height": 61.906710310965636,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
